# --- PostgreSQL (Clever Cloud add-on) -------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
POSTGRESQL_ADDON_HOST=your-host.services.clever-cloud.com
POSTGRESQL_ADDON_PORT=5432
POSTGRESQL_ADDON_DB=your_database
POSTGRESQL_ADDON_USER=your_user
POSTGRESQL_ADDON_PASSWORD=your_password

# --- App secrets ----------------------------------------------------------
# 256-bit base64-encoded HS256 signing key. Generate with:
#   openssl rand -base64 32
APP_JWT_SECRET=change-me-in-prod

# --- Bootstrap super-admin (only used on first boot when users table empty)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@nms.local
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
APP_BOOTSTRAP_ADMIN_NAME=Root Admin

# --- Media storage --------------------------------------------------------
APP_MEDIA_LOCAL_ROOT=./uploads
